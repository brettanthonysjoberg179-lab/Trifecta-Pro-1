# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FORMFAV_API_KEY: Required for live FormFav MCP calls (https://api.formfav.com/mcp).
# Generate a free key at https://formfav.com/get-api-key?cta=mcp and add it in Settings > Secrets.
FORMFAV_API_KEY="MY_FORMFAV_API_KEY"

# FIRECRAWL_API_KEY: Required for live Firecrawl scraping & search (https://api.firecrawl.dev/v1).
# Generate an API key at https://www.firecrawl.dev/app/api-keys and add it in Settings > Secrets.
FIRECRAWL_API_KEY="MY_FIRECRAWL_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
